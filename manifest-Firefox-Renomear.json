{
  "manifest_version": 3,
  "name": "Monitor SARP",
  "version": "1.0.2",
  "description": "Extensão para monitoramento e notificação no SARP-SAÚDE-RN",
  "author": "Jamerson J. Silva",

  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "alarms",
    "notifications",
    "scripting"
  ],

  "host_permissions": [
    "https://sarp.saude.rn.gov.br/*",
    "https://ntfy.sh/*"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Monitor SARP",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "scripts": ["background/background.js"],
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://sarp.saude.rn.gov.br/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_end"
    }
  ],

  "options_page": "options/options.html",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "monitorsarp-jamerson@saude.rn.gov.br"
    }
  }
}